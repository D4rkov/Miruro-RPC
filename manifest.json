{
  "manifest_version": 3,
  "name": "Miruro RPC",
  "version": "3.0.12",
  "description": "Discord Rich Presence for Miruro via Social Layer (extension only).",
  "browser_specific_settings": {
    "gecko": {
      "id": "miruro-rpc@darkov",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteActivity",
          "websiteContent",
          "personallyIdentifyingInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Miruro RPC",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://graphql.anilist.co/*",
    "https://miruro.cx/*",
    "https://www.miruro.cx/*",
    "https://*.miruro.cx/*",
    "https://d4rkov.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://miruro.cx/*",
        "*://www.miruro.cx/*",
        "*://*.miruro.cx/*"
      ],
      "js": ["content/miruro.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://d4rkov.github.io/miruro-rpc-oauth/*"
      ],
      "js": ["content/oauth-callback.js"],
      "run_at": "document_start"
    }
  ]
}
